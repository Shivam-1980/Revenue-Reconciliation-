# Copy to a secure environment manager; never commit real secrets.
APP_ENV=hosted
PLATFORM_SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS
PLATFORM_TOKEN_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARS
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@DB_HOST:5432/eko_platform
PLATFORM_AUTH_MODE=oidc
OIDC_ISSUER_URL=https://YOUR_IDENTITY_PROVIDER/TENANT
OIDC_CLIENT_ID=YOUR_CLIENT_ID
OIDC_CLIENT_SECRET=INJECT_FROM_SECRET_MANAGER
OIDC_REDIRECT_URI=https://YOUR_API_HOST/api/auth/oidc/callback
OIDC_FRONTEND_SUCCESS_URL=https://YOUR_FRONTEND_HOST/platform-login
OIDC_SCOPES=openid email profile
CORS_ORIGINS=https://YOUR_FRONTEND_HOST
TENANT_STORAGE_ROOT=/secure/persistent/eko-tenants
MAX_UPLOAD_MB=50
TENANT_UPLOAD_MAX_MB=50
