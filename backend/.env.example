# Copy this file to backend/.env and fill in real values. backend/.env is never packaged.
APP_ENV=local
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=50

# --- HTTPS ---
# true: backend and dashboard use https://127.0.0.1 with a local certificate (created automatically). Run trust_local_cert.bat once
# so the browser does not warn. For a server, put the app behind a TLS proxy (see docs/HOSTING_HTTPS.md) and set EKO_BEHIND_PROXY=true.
EKO_HTTPS=false
EKO_BEHIND_PROXY=false

# --- Reach the app from another computer (the other agent, a colleague) ---
# 127.0.0.1 (default): only this PC. 0.0.0.0: every network address of this PC. Requires EKO_HTTPS=true (the app refuses plain HTTP on a
# network address). The certificate is then made for this PC's network addresses. Windows also needs allow_network_access.bat once
# (as administrator). See docs/AGENT_API.md, section "Reach it from another computer".
EKO_BIND_HOST=127.0.0.1

# --- Database ---
# embedded (default): PostgreSQL 16 managed by the app (data in backend/data/pgdata, password-protected, 127.0.0.1 only).
# sqlite: the local file backend/data/platform.sqlite3. An explicit DATABASE_URL below overrides both.
# Existing SQLite data (accounts, saved months) is copied into PostgreSQL automatically the first time.
EKO_DATABASE=embedded
# --- External PostgreSQL (optional) ---
# Tables are created automatically on startup. Use a dedicated database and user, e.g.:
# DATABASE_URL=postgresql://eko_app:<password>@127.0.0.1:5432/eko_reconciliation
DATABASE_URL=

# --- Backups (encrypted, automatic daily + after every saved month) ---
# Put them on another drive or a OneDrive folder, e.g. EKO_BACKUP_DIR=D:\EkoBackups . Default: backend/data/backups
EKO_BACKUP_DIR=
EKO_BACKUP_KEEP=14

# --- Sign-in: password only (lockout after repeated wrong passwords, rate limits, idle timeout) ---

# Session lifetime (seconds): sign-out after inactivity, and an absolute maximum.
SESSION_IDLE_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=28800

# Optional fixed secrets. If empty, a random per-installation secret is generated in
# backend/data/local_secrets.json on first start (required to be set in hosted mode).
PLATFORM_TOKEN_SECRET=
PLATFORM_SESSION_SECRET=

# --- Google sign-in (optional; run setup_google_login.bat to fill these in) ---
# Create a Web client in Google Cloud Console (see docs/GOOGLE_SIGN_IN.md). The person must also exist as a user in the app.
# OIDC_ISSUER_URL=https://accounts.google.com
# OIDC_CLIENT_ID=<client id>.apps.googleusercontent.com
# OIDC_CLIENT_SECRET=<client secret>
# OIDC_REDIRECT_URI=http://127.0.0.1:8000/api/auth/oidc/callback
