# Copy to your deployment secret/configuration store; do not commit real secrets.
APP_ENV=hosted
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/eko_platform
PLATFORM_TOKEN_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_BYTES
PLATFORM_TOKEN_TTL_SECONDS=3600
PLATFORM_DB_PATH=./data/platform.sqlite3
TENANT_STORAGE_ROOT=./data/tenants
TENANT_UPLOAD_MAX_MB=50
CORS_ORIGINS=https://your-approved-frontend.example
OIDC_ISSUER_URL=https://YOUR_IDP_ISSUER
OIDC_CLIENT_ID=YOUR_CLIENT_ID
OIDC_CLIENT_SECRET=LOAD_FROM_SECRET_STORE
OIDC_REDIRECT_URI=https://your-api.example/api/auth/oidc/callback
OIDC_FRONTEND_SUCCESS_URL=https://your-frontend.example/platform-login
OIDC_SCOPES=openid email profile
# Sign-in uses the e-mail and password (no e-mailed code).
