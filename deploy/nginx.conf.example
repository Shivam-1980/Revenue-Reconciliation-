# nginx: TLS termination in front of the app. Replace eko.example.com and the certificate paths (e.g. from certbot).
server {
    listen 80;
    server_name eko.example.com;
    return 308 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name eko.example.com;

    ssl_certificate     /etc/letsencrypt/live/eko.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/eko.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'" always;

    client_max_body_size 60m;
    proxy_read_timeout 300s;

    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location = /health { proxy_pass http://127.0.0.1:8000; }
    location / {
        root /srv/eko/frontend/dist;
        try_files $uri /index.html;
    }
}
